# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF...

# ID чата администратора для алертов (необязательно, но рекомендуется).
# Узнать свой ID можно у @userinfobot
ADMIN_CHAT_ID=

# Путь к бинарнику yt-dlp. По умолчанию берётся из PATH ("yt-dlp").
YTDLP_PATH=yt-dlp

# Путь к ffmpeg (склейка видео и извлечение звука). По умолчанию из PATH.
FFMPEG_PATH=ffmpeg

# Путь к ffprobe. По умолчанию берётся из PATH ("ffprobe").
FFPROBE_PATH=ffprobe

# Рабочая папка для временных файлов загрузок.
# Локально можно оставить ./tmp, на VPS удобнее /var/tiktokbot/tmp
TMP_DIR=./tmp

# --- Лимиты и нагрузка ---
# Сколько загрузок выполнять одновременно
QUEUE_CONCURRENCY=2
# Максимальная длина очереди (сверх — отказ "сервер занят")
QUEUE_MAX_SIZE=20
# Лимит видео на пользователя в окне (см. ниже)
USER_LIMIT_COUNT=5
# Окно лимита в минутах
USER_LIMIT_WINDOW_MIN=60

# --- Технические лимиты ---
# Максимальный размер файла для отправки (Telegram cloud API = 50 МБ)
MAX_FILESIZE_MB=49
# Таймаут одной загрузки в секундах
DOWNLOAD_TIMEOUT_SEC=300
# Минимум свободного места на диске для старта загрузки (МБ)
MIN_FREE_DISK_MB=2000

# apiRoot для Telegram. Оставить пустым = облачный api.telegram.org.
# Понадобится только если в будущем поднимете локальный telegram-bot-api.
TELEGRAM_API_ROOT=
